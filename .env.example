# Copy to .env locally. Do not commit .env.
# Leave secrets empty until you set your own local values.

DATABASE_URL=
APP_ENCRYPTION_KEY=

API_PORT=3001
WEB_PORT=3000

# Browser-facing API origin (not a secret). Never put API keys here.
NUXT_PUBLIC_API_BASE=http://localhost:3001

MYSQL_PORT=3306
MYSQL_DATABASE=icooro
MYSQL_USER=icooro
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
