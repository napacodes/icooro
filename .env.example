# Copy to .env locally. Do not commit .env.
# Leave secrets empty until you set your own local values.

DATABASE_URL=
APP_ENCRYPTION_KEY=

API_PORT=3001
WEB_PORT=3000

# Storage configuration
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# Browser-facing API origin (not a secret). Never put API keys here.
NUXT_PUBLIC_API_BASE=http://localhost:3001

# Browser origins allowed to call the API with credentials (not a secret).
# Comma-separated. Defaults to http://localhost:3000 when unset.
# Add a LAN origin here (and point NUXT_PUBLIC_API_BASE at the same host)
# to test from another machine, e.g. http://192.168.1.49:3000
API_CORS_ORIGINS=http://localhost:3000

MYSQL_PORT=3306
MYSQL_DATABASE=icooro
MYSQL_USER=icooro
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Real AI Provider configuration (ChatFire)
CHATFIRE_BASE_URL=https://api.chatfire.site
CHATFIRE_API_KEY=
