{
  "name": "@icooro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./test/setup-env.cjs --import tsx/esm --test \"test/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@icooro/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.8",
    "mysql2": "^3.24.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
